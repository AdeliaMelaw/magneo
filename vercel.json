{
  "routes": [
    {
      "src": "/portfolio/legal-websites/personal-injury-bold/test/?",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      },
      "continue": true
    },
    {
      "src": "/portfolio/legal-websites/personal-injury-classic/test/?",
      "status": 308,
      "headers": {
        "Location": "https://magneo.ca/portfolio/legal-websites/personal-injury-classic/"
      }
    },
    {
      "src": "/portfolio/legal-websites/test/?",
      "status": 308,
      "headers": {
        "Location": "https://magneo.ca/portfolio/legal-websites/"
      }
    },
    {
      "src": "/portfolio/test/?",
      "status": 308,
      "headers": {
        "Location": "https://magneo.ca/portfolio/"
      }
    },
    {
      "src": "/downloads/personal-branding-guide-legal-professionals\\.pdf",
      "dest": "https://blog.magneo.ca/wp-content/uploads/2026/05/magneo-personal-branding-guide-legal-professionals.pdf"
    },
    {
      "src": "/blog/?",
      "status": 308,
      "headers": {
        "Location": "https://blog.magneo.ca/blog/"
      }
    },
    {
      "src": "/blog/(.*)",
      "status": 308,
      "headers": {
        "Location": "https://blog.magneo.ca/blog/$1"
      }
    },
    {
      "src": "/about-us/?",
      "status": 308,
      "headers": {
        "Location": "https://magneo.ca/about/adele-salikhova/"
      }
    },
    {
      "src": "/sitemap_index\\.xml",
      "status": 308,
      "headers": {
        "Location": "https://magneo.ca/sitemap.xml"
      }
    },
    {
      "src": "/sitemap\\.xml",
      "dest": "/sitemap.xml",
      "headers": {
        "Content-Type": "application/xml; charset=utf-8"
      }
    },
    {
      "src": "/ai-sitemap\\.xml",
      "dest": "/ai-sitemap.xml",
      "headers": {
        "Content-Type": "application/xml; charset=utf-8"
      }
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
