{
  "routes": [
    {
      "src": "/blog/?",
      "status": 308,
      "headers": {
        "Location": "https://blog.magneo.ca/blog/"
      }
    },
    {
      "src": "/blog/(.*)",
      "status": 308,
      "headers": {
        "Location": "https://blog.magneo.ca/blog/$1"
      }
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
